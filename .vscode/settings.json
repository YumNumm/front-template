{
  "git.enableCommitSigning": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.associations": {
    "./.vscode/*.json": "jsonc"
  },
  "editor.formatOnSave": true,
  "[typescript][javascript][typescriptreact][json][jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "npm.packageManager": "pnpm",
  "editor.pasteAs.enabled": true,
  "oxc.configPath": ".oxlintrc.json",
  "oxc.fixKind": "all",
  "oxc.fmt.configPath": ".oxfmtrc.json",
  "oxc.path.oxfmt": "node_modules/oxfmt/bin/oxfmt",
  "oxc.path.oxlint": "node_modules/oxlint/bin/oxlint",
  "oxc.path.tsgolint": "node_modules/oxlint-tsgolint/bin/tsgolint.js",
  "oxc.tsConfigPath": "tsconfig.json",
  "oxc.typeAware": true
}
