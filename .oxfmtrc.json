{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "dist",
    ".output",
    ".tanstack",
    "*.yaml",
    "**/routeTree.gen.ts"
  ],
  "arrowParens": "avoid",
  "singleQuote": true,
  "jsxSingleQuote": true,
  "printWidth": 80,
  "experimentalTailwindcss": {},
  "experimentalSortImports": {
    "order": "asc",
    "groups": [
      ["type"],
      ["builtin"],
      ["external"],
      ["subpath", "internal"],
      ["parent"],
      ["sibling"],
      ["index"]
    ]
  }
}
